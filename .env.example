# -------------------------------------------------------------
# SideQuest Environment Variables
# ALL of these are 100% OPTIONAL!
# The app works out of the box with $0 cost and ZERO API keys.
# -------------------------------------------------------------

# Optional: CARTO Basemap API Key (if you prefer CARTO over open-source OpenStreetMap)
# Get a free key at: https://carto.com/basemaps/apikey
# NEXT_PUBLIC_CARTO_API_KEY=your_free_carto_api_key_here

# Optional: Supabase PostgreSQL + PostGIS credentials (for cross-device database sync)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Google AI Studio Gemini API Key (for dynamic AI Wingman icebreaker generation)
# GEMINI_API_KEY=your_gemini_api_key_here
