# ==============================================================================
# SIDEQUEST ANALYTICS & PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================

# 1. PostHog Product Analytics (Session Replay, Conversion Funnels, User Retention)
# Create a free account at https://posthog.com (1,000,000 free events / month)
# Project Settings -> Project Variables -> Project API Key
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# 2. Google Analytics 4 (Marketing Campaign Attribution & Web Traffic)
# Create a free property at https://analytics.google.com
# Admin -> Data Streams -> Web -> Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# 3. Optional Supabase Backend (if connecting live persistent database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
